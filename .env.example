# Flask
FLASK_ENV=development

# Developer admin access (single source of truth for /admin* routes)
DEVELOPER_ADMIN_EMAIL=chatterjeerupak6@gmail.com
# Optional fallback key (used only if DEVELOPER_ADMIN_EMAIL is not set)
DEVELOPER_EMAIL=chatterjeerupak6@gmail.com

# Mail configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
