# Flask core
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
PORT=10000

# SQLite database (relative to project root in Render)
DATABASE_PATH=finance.db

# Developer admin access
DEVELOPER_ADMIN_EMAIL=developer@example.com
# Optional fallback key (used only if DEVELOPER_ADMIN_EMAIL is not set)
DEVELOPER_EMAIL=developer@example.com

# Gemini / Google AI
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional fallback key name
GOOGLE_API_KEY=
# Optional model override
GEMINI_MODEL=

# SMTP / Flask-Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-smtp-username@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=your-smtp-username@example.com
MAIL_DEBUG_LOG_OTP=false
